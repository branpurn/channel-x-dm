{
  "id": "x-dm",
  "name": "X DM",
  "description": "Send and receive X (Twitter) Direct Messages via the X API.",
  "activation": { "onStartup": true },
  "channels": ["x-dm"],
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} },
  "channelConfigs": {
    "x-dm": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "dmPolicy": { "type": "string", "enum": ["pairing","allowlist","open","disabled"], "default": "allowlist" },
          "allowFrom": { "type": "array", "items": { "type": "string" } },
          "groupAllowFrom": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "label": "X DM",
      "description": "X (Twitter) Direct Messages via the X API (adaptive polling inbound)."
    }
  }
}
