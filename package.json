{
  "name": "@branpurn/x-dm",
  "version": "1.0.0",
  "description": "OpenClaw channel plugin for X (Twitter) Direct Messages",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "setupEntry": "./src/channel.setup.js",
    "channel": {
      "id": "x-dm",
      "label": "X DM",
      "selectionLabel": "X DM (unencrypted, X API)",
      "blurb": "Bidirectional X (Twitter) DMs over the paid X API."
    },
    "compat": {
      "pluginApi": ">=2026.6.9"
    },
    "build": {
      "openclawVersion": "2026.6.9"
    }
  },
  "dependencies": {}
}
