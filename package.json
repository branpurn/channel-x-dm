{
  "name": "@branpurn/x-dm",
  "version": "1.0.0",
  "description": "OpenClaw channel plugin for X Direct Messages (classic DM + opt-in X Chat)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "src",
    "tools",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "setupEntry": "./src/setup-entry.js",
    "channel": {
      "id": "x-dm",
      "label": "X DM",
      "selectionLabel": "X DM (classic + opt-in Chat)",
      "blurb": "Bidirectional X DMs over the paid X API. Classic unencrypted DM by default; opt-in X Chat transport."
    },
    "compat": {
      "pluginApi": ">=2026.6.9"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "dependencies": {},
  "optionalDependencies": {
    "@xdevplatform/chat-xdk": "^0.4.3",
    "juicebox-sdk": "^0.3.0"
  }
}
